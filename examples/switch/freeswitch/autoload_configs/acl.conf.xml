<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!-- Used by the external profile (5080, no digest auth): only FreeSBC's
         private.ip may send to it. Default deny. One node per line; both nodes of a
         two-node pair are listed (freesbc_a_ip / freesbc_b_ip in freesbc-vars.xml). -->
    <list name="freesbc_carrier" default="deny">
      <node type="allow" cidr="$${freesbc_a_ip}/32"/>
      <!-- NODE B: delete this line for a single node. -->
      <node type="allow" cidr="$${freesbc_b_ip}/32"/>
    </list>

    <!-- Stock "domains" list. It is NOT applied to the internal profile (see
         sip_profiles/internal.xml). Do not add cidr= to directory users or a
         FreeSBC node address here: that would make every client call trusted. -->
    <list name="domains" default="deny">
      <node type="allow" domain="$${domain}"/>
    </list>
  </network-lists>
</configuration>
