# FreeSBC load-test environment. Copy to env and edit:
#
#   cp env.example env && $EDITOR env && ./render.sh
#
# Every address is written once here; render.sh expands the templates for
# all three hosts into out/. Values are plain shell assignments.

# --- S1: SIPp load generator (public) ----------------------------------------
# Addresses FreeSBC sees as the source of SIPp traffic (after any 1:1 NAT,
# so in a cloud this is the EIP, not the VM's VPC address).
SIPP_CARRIER_IP=198.51.100.10   # plays the carriers; listed in edge.carriers / carrier_sources
SIPP_CLIENT_IP=198.51.100.11    # plays phones; must NOT be a carrier source
                                # (equal to SIPP_CARRIER_IP = single-IP mode, see README)
# Local addresses SIPp binds (-i). Equal to the two above unless S1 is behind
# 1:1 NAT (cloud VM): then the VPC addresses that map to them.
SIPP_CARRIER_BIND=198.51.100.10
SIPP_CLIENT_BIND=198.51.100.11

# --- S2: FreeSBC (public + private) ------------------------------------------
SBC_PUBLIC_IP=203.0.113.7       # public.ip: advertised; the EIP in a cloud
SBC_PUBLIC_BIND=203.0.113.7     # public.bind: local address (VPC IP behind 1:1 NAT)
SBC_PRIVATE_IP=10.77.0.2        # private.ip: on the NIC that faces S3
SBC_RTP=10000-59999             # 25000 RTP/RTCP pairs per side
SBC_ADMIN=127.0.0.1:8080
SBC_ADMIN_PASSWORD=change-me    # bcrypt hash is generated by render.sh

# --- S3: switches (private LAN only) -----------------------------------------
SWITCH_IP=10.77.0.20
FS_PORT=5060                    # FreeSWITCH internal profile (clients, auth)
FS_CARRIER_PORT=5080            # FreeSWITCH external profile (carriers, no auth)
FS_RTP=30000-39999
AST_PORT=5160                   # Asterisk: one transport for clients and carriers
AST_RTP=40000-49999

# --- Numbering plan (identical on both switches) ------------------------------
USERS_A_FIRST=10000             # calling phones (T3): 10000..
USERS_A_COUNT=1000
USERS_B_FIRST=20000             # agents that receive calls (T4): 20000..
USERS_B_COUNT=1000
USER_PASSWORD=Load-Test-Pw-1    # one password for every generated user

# --- SIPp local ports on S1 --------------------------------------------------
SIPP_CARRIER_UAC_PORT=5072      # T1/T2/T4 caller (carrier -> switch)
SIPP_CARRIER_UAS_PORT=5070      # T2 far end (switch -> carrier); this is the carrier entry
SIPP_CLIENT_A_PORT=5061         # T3/T5 phones (register + call from the same socket)
SIPP_CLIENT_B_PORT=5062         # T4 agents (register, then answer on the same socket)
SIPP_RTP_MIN=16000              # per-call RTP ports of SIPp's rtp_stream
SIPP_RTP_MAX=59999
