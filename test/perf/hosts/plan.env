# Address plan of the 3-host run: the single source of every address.
# Plain KEY=value, sourced by provision.sh, render.sh and env.sh (and readable
# by the AGENTS.md files). Edit it when instances are recreated with other
# addresses, then re-run provision.sh on each host (it re-renders everything).
#
# Only VPC-private addresses belong here. The public IPv4s used to ssh in from
# the laptop live in the laptop's ~/.ssh/config (STEPS.md), never in this file.
#
# A value of __ASSIGN_IN_CONSOLE__ is a placeholder for something that does not
# exist yet (the private vSwitch and the addresses in it). provision.sh and
# render.sh refuse to run until every one is replaced (STEPS.md, R01).

# Formal run (issue #109): two vSwitches in one zone, one security group.
#   public  vSwitch: A (eth0, primary + two secondary IPs) and B's eth0
#   private vSwitch: B's second ENI (eth1) and C (eth0)
# The VPC routes between the two vSwitches, so A reaches C (ssh, sshfs) without
# any OS route. FreeSBC's private plane only ever talks to C, on-link on eth1.
# A cannot reach B_PRIV_IP, and nothing needs it: B answers by eth0 (A's subnet
# is on-link there) and the VPC drops a reply whose source is not that ENI's.
SUBNET_CIDR=172.30.96.0/20               # public vSwitch
PREFIX_LEN=20
PRIV_SUBNET_CIDR=172.16.0.0/24            # private vSwitch CIDR, for example 172.30.112.0/24 (R01)
PRIV_PREFIX_LEN=24                        # its prefix length, for example 24

# Interface that holds each host's primary IP and default route (R00 shows it).
NET_IF=eth0

# A "loadgen": SIPp UAC, webrtcload, run.sh. Public vSwitch only.
A_IP=172.30.106.138                      # primary IP of A: client generator (LOADGEN_IP)
A_CARRIERGEN_IP=172.30.106.139           # secondary IP on A: carrier generator (CARRIERGEN_IP, in carrier_sources)
A_CARRIER_UAS_IP=172.30.106.140          # secondary IP on A: carrier UAS for carrier-out (CARRIER_IP)
A_EXTRA_IF=eth0                          # interface that carries the two IPs above (the primary ENI)
A_LOADGEN2_IP=172.30.106.141             # optional third secondary IP on A: a second client source for M06
                                         # (FreeSBC caps unanswered calls at 64 per public source IP). Empty = none.
                                         # It must not be in carrier_sources or edge.carriers.

# B "sbc": FreeSBC. eth0 in the public vSwitch, eth1 (second ENI) in the private one.
B_PUB_IP=172.30.106.134                  # primary IP of eth0: public.ip = public.bind
B_PRIV_IP=172.16.0.109                   # primary IP of the second ENI in the private vSwitch: private.ip
B_PRIV_IF=eth1                           # that ENI's interface name in the OS (R00 shows it)
B_PRIV_ADDR_MODE=static                  # static: provision.sh writes B_PRIV_IP/PRIV_PREFIX_LEN into netplan
                                         # dhcp: eth1 takes its address by DHCP (the lease must equal B_PRIV_IP)
                                         # Either way there is no default route on eth1.
B_GOMEMLIMIT=6GiB                        # soft Go limit on B (4 vCPU / 8 GiB nominal, 7.35 GiB usable, like the competitor's 8 GB box)
B_MEMORY_MAX=                            # empty: no cgroup cap (B has 8 GiB of its own). Only for a stand-in with more RAM.

# C "switch": FreeSWITCH :5090, Asterisk :5080, SIPp UAS :5060. Private vSwitch only
# (it keeps a public IP for ssh and for apt/docker/github; that one is never used here).
C_IP=172.16.0.110                        # primary IP of C in the private vSwitch

# Registry mirror for Docker on C (empty = none). It is the account-specific
# accelerator URL from the Alibaba console: 容器镜像服务 -> 镜像加速器. When set,
# provision.sh writes /etc/docker/daemon.json with it and pulls FS_IMAGE through it.
DOCKER_REGISTRY_MIRROR=                  # your account's accelerator URL (account-specific, never committed)
