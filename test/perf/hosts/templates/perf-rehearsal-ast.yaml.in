# FreeSBC configuration for the 3-host rehearsal (test/perf/hosts/STEPS.md),
# Asterisk as the switch. TEMPLATE: provision.sh renders it from plan.env into
# /etc/perf-kit/configs/ ; do not edit the rendered copy.
#
#   loadgen (A)        sbc (B)                            switch (C)
#   @A_IP@  ->  public @B_PUB_IP@ | private @B_PRIV_IP@  ->  @C_IP@:5080
#
# Asterisk (pjsip, test/perf/hosts/asterisk/) listens on @C_IP@:5080 and
# identifies FreeSBC by IP @B_PRIV_IP@: endpoint "perf" accepts REGISTER and
# INVITE without digest for users u000001.., w000001.. and echoes ext 2000.
# The same generator scenarios as for FreeSWITCH apply, so run.sh needs no
# change: SWITCH=freeswitch test/perf/run.sh ... (it only means "no SIPp UAS").
# Install with `freesbc-use ast` on the sbc host. Throwaway admin password
# ("perf"): rehearsal only.

public:
  ip: @B_PUB_IP@             # B's eth0 IP in the public vSwitch (advertised); public.bind = ip.

private:
  ip: @B_PRIV_IP@            # B's eth1 (second ENI) in the private vSwitch (bind = advertised).
                             # The private SIP socket is fixed: @B_PRIV_IP@:5060.

rtp: 10000-59999             # 25000 calls per plane

tls:
  cert: /etc/freesbc/cert.pem
  key: /etc/freesbc/key.pem

edge:
  switch: [@C_IP@:5080]      # Asterisk's pjsip transport

  listen:
    udp: 5060
    tcp: 5060
    ws: 8080
    wss: 443

shield:
  rate_limit: 1000000/s per_ip
  carrier_rate_limit: 1000000/s per_ip
  ban: 1m
  max_sessions: 25000        # explicit: the pair count of rtp; no session cap in the way

admin:
  listen: 127.0.0.1:8081
  pprof: true
  password_hash: "$2y$10$sbCGIYv.0V/JCrqC.ZBQEuzSWlVidnXE898iuyV8L1lbOTHzqabju"   # password: perf
