<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- carrier UAS: decline with 486 Busy Here.
     The SBC must relay the real code verbatim (no failover). -->
<scenario name="uas_486">
  <recv request="INVITE" crlf="true"/>

  <send>
    <![CDATA[
      SIP/2.0 486 Busy Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <recv request="ACK" crlf="true"/>
</scenario>
